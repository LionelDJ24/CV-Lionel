          </svg>
        </span>
        <div>
          <p class="contact-label">GitHub</p>
          <a href="https://github.com/LionelDJ24" target="_blank" rel="noopener">Voir mes projets</a>
        </div>
      </div>
    </div>
  </div>

</section>

<style>
  /* VARIABLES */
  :root {
    --primary-color: #4338ca;
    --secondary-color: #7c3aed;
    --accent-color: #06b6d4;
    --text-dark: #1f2937;
    --text-light: #6b7280;
    --bg-light: #f9fafb;
    --shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    --shadow-hover: 0 15px 40px rgba(67, 56, 202, 0.2);
  }

  /* CONTAINER */
  #cv-content {
    padding: 80px 10%;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* SECTIONS */
  .section {
    margin-bottom: 120px;
    animation: fadeInUp 0.6s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .section h2 {
    font-size: 2.5rem;
    margin-bottom: 2rem;
    color: var(--primary-color);
    font-weight: 700;
    position: relative;
    padding-bottom: 15px;
  }

  .section h2::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 60px;
    height: 4px;
    background: linear-gradient(90deg, var(--primary-color), var(--accent-color));
    border-radius: 2px;
  }

  .section h3 {
    font-size: 1.4rem;
    color: var(--text-dark);
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  p {
    font-size: 1.2rem;
    line-height: 1.8;
    color: var(--text-light);
    margin-bottom: 1rem;
  }

  .highlight {
    color: var(--secondary-color);
    font-weight: 600;
  }

  /* PROFIL SECTION */
  .profil-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 50px;
    align-items: center;
  }

  .profil-text p {
    font-size: 1.3rem;
  }

  .profil-image img {
    width: 100%;
    max-width: 300px;
    border-radius: 20px;
    box-shadow: var(--shadow);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .profil-image img:hover {
    transform: scale(1.05) rotate(2deg);
    box-shadow: var(--shadow-hover);
  }

  /* PROJET PROFESSIONNEL */
  .projet-intro {
    margin-bottom: 30px;
  }

  .projet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 25px;
    margin-bottom: 30px;
  }

  .projet-card {
    background: white;
    padding: 25px;
    border-radius: 12px;
    box-shadow: var(--shadow);
    transition: all 0.3s ease;
  }

  .projet-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-hover);
  }

  .projet-card h3 {
    color: var(--primary-color);
    font-size: 1.3rem;
    margin-bottom: 15px;
  }

  .projet-card p {
    margin: 0;
  }

  .vision-box {
    background: linear-gradient(135deg, #e0e7ff 0%, #ddd6fe 100%);
    padding: 30px;
    border-radius: 12px;
    border-left: 5px solid var(--primary-color);
    margin-top: 20px;
  }

  .vision-box h3 {
    color: var(--primary-color);
    font-size: 1.4rem;
    margin-bottom: 15px;
  }

  .vision-box p {
    color: var(--text-dark);
    margin: 0;
    font-size: 1.2rem;
  }

  /* QUALITIES & VALUES CARDS */
  .qualities-grid,
  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
  }

  .quality-card,
  .value-card {
    background: white;
    padding: 35px;
    border-radius: 15px;
    box-shadow: var(--shadow);
    transition: all 0.3s ease;
    text-align: center;
  }

  .quality-card:hover,
  .value-card:hover {
    transform: translateY(-10px);
    box-shadow: var(--shadow-hover);
  }

  .quality-icon,
  .value-icon {
    font-size: 3.5rem;
    margin-bottom: 20px;
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .quality-card:hover .quality-icon,
  .value-card:hover .value-icon {
    transform: scale(1.2) rotate(10deg);
  }

  .quality-card h3,
  .value-card h3 {
    color: var(--primary-color);
    margin-bottom: 15px;
  }

  .quality-card p,
  .value-card p {
    font-size: 1.1rem;
    margin: 0;
  }

  /* ANTI-VALUES */
  .anti-values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 25px;
  }

  .anti-value-card {
    background: linear-gradient(135deg, #fff5f5 0%, #fee2e2 100%);
    padding: 30px;
    border-radius: 12px;
    border-left: 4px solid #e19999;
    transition: all 0.3s ease;
    text-align: center;
  }

  .anti-value-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(220, 38, 38, 0.2);
  }

  .anti-value-icon {
    font-size: 2.5rem;
    margin-bottom: 15px;
  }

  .anti-value-card h3 {
    color: #dc2626;
    font-size: 1.2rem;
    margin-bottom: 12px;
  }

  .anti-value-card p {
    font-size: 1rem;
    color: #991b1b;
    margin: 0;
  }

  /* TIMELINE */
  .timeline {
    position: relative;
    padding-left: 40px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, var(--primary-color), var(--accent-color));
  }

  .timeline-item {
    margin-bottom: 35px;
    position: relative;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -47px;
    top: 5px;
    width: 14px;
    height: 14px;
    background: var(--primary-color);
    border: 3px solid white;
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(67, 56, 202, 0.2);
  }

  .year {
    display: inline-block;
    background: var(--primary-color);
    color: white;
    padding: 5px 15px;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .timeline-content {
    background: white;
    padding: 20px 25px;
    border-radius: 12px;
    box-shadow: var(--shadow);
    transition: all 0.3s ease;
  }

  .timeline-content:hover {
    transform: translateX(10px);
    box-shadow: var(--shadow-hover);
  }

  .timeline-content h3 {
    color: var(--primary-color);
